# 首次启动不预置网关访问密钥。登录控制台后手动添加；每一组密钥可访问全部已部署上游。
# 每个实例的上游 API Key 在控制台单独设置，不写入此全局配置。
# INSTANCE_ADMIN_TOKEN 是可选的控制面内部凭据；留空时会在 CONTROL_DATA_DIR 自动生成并持久化。
PROXY_REFRESH_INTERVAL=30s
# 按顺序尝试公网 IP 探测地址，并按实际出口 IP 去重
PROXY_PROBE_URL=https://api.ipify.org,https://ifconfig.me/ip,https://www.cloudflare.com/cdn-cgi/trace
PROXY_PROBE_TIMEOUT=10s
PROXY_PROBE_CONCURRENCY=8
# 0 表示自动使用各实例的并发上限
TARGET_EGRESS_SLOTS=0
# 429/5xx 或首输出前断流时，最多再尝试两个尚未使用的不同出口
MAX_RETRIES=2
REQUEST_TIMEOUT=5m
# 流式请求在该时间内必须出现文本、推理、工具调用或 Responses 完成事件；0 关闭
STREAM_FIRST_OUTPUT_TIMEOUT=20s
# 首输出前断流或超时的出口对当前模型至少冷却多久；0 关闭额外冷却
STREAM_FAILURE_COOLDOWN=10m
COOLDOWN_BASE=5s
COOLDOWN_MAX=60s
# 模型名、Responses 入参和推理参数默认原样透传
# TokenRouter 默认移除 session_id、previous_response_id、conversation_id，避免复用上游状态
ISOLATE_UPSTREAM_STATE=true
FREE_MODELS_ONLY=false
DISABLE_THINKING_BY_DEFAULT=false
MIN_THINKING_MAX_TOKENS=0
# 多实例 Compose 的 Mihomo 容器由控制台管理；通常无需修改以下默认值
MIHOMO_CONTAINER=dualroute-gateway-mihomo
MIHOMO_CONFIG_DIR=/mihomo-config
MIHOMO_API_URL=http://mihomo:9090
# 每个实例至少需要一个独立槽位；槽位可在订阅节点之间动态换线
MIHOMO_MAX_SLOTS=64
# 可选：宿主机映射端口；默认控制面 13338、API 13337
CONTROL_HOST_PORT=13338
API_HOST_PORT=13337
# false：存在代理实例时，内置路由器不再把请求分配给直连实例
DIRECT_FALLBACK=false
# 可选：控制台从 GitHub 刷新 FreeBuff 动态模型目录时使用的 HTTP/HTTPS 代理。
# 例如 http://mihomo:7890；留空则由控制面直连，实例请求出口不受此项影响。
FREEBUFF_MODELS_PROXY_URL=
# 可选：FreeBuff 动态模型目录的 GitHub 地址列表，按顺序回退；只填写自己信任的镜像。
FREEBUFF_MODELS_URLS=https://github.com/pingmike2/freebuff2api-wokers/releases/download/models-cache/freebuff-models.json
# Vertex 上游由网关内置直连（Google 匿名端点），无需任何部署配置；
# 在控制台创建 Vertex 实例并为其分配 HTTP/HTTPS/SOCKS5 出口即可使用。
# 兼容旧配置名：NGINX_HOST_PORT、NGINX_DIRECT_FALLBACK
